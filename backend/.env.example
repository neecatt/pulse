# Copy to .env and adjust. Every setting is optional; defaults are in src/pulse/config.py.

# Local state: SQLite database and Pulse's generated SSH key.
PULSE_DATA_DIR=data
PULSE_DATABASE_URL=sqlite+aiosqlite:///./data/pulse.db
# Other origins allowed to call the API with cookies. `make dev` adds the Vite dev
# server; leave unset in production (the web app is served by Pulse itself).
# PULSE_CORS_ORIGINS=["http://localhost:5173"]
# Serve the built web app from the API process (`make start` sets this).
# PULSE_STATIC_DIR=../frontend/dist

# Sign-in. Set both to create the admin account on startup; the password then
# follows this file (change it here and restart). Leave them unset to create the
# admin in the browser on first visit. Docker secrets also work: put the value in
# /run/secrets/pulse_admin_password.
# PULSE_ADMIN_USERNAME=admin
# PULSE_ADMIN_PASSWORD=
# PULSE_ALLOW_SIGNUP=false          # let anyone with the URL create an account
# PULSE_DEMO=false                   # landing page + "Try the demo" guests (simulated clusters)
# PULSE_SESSION_DAYS=30
# PULSE_SECURE_COOKIES=auto          # auto | always | never
# PULSE_TRUSTED_PROXIES=127.0.0.1    # proxies allowed to set X-Forwarded-* headers
# PULSE_PUBLIC_URL=https://pulse.example.org   # pins the domain passkeys belong to (optional)

# "mock" simulates a cluster; "ssh" runs sacct on each account's login node.
PULSE_SLURM_BACKEND=mock
# Each user gets their own SSH key, shown in the app: the first account's is
# data/pulse_ed25519 (or this existing key), the others' are in data/ssh/.
# PULSE_SSH_KEY_PATH=/home/pulse/.ssh/id_ed25519
# Host keys are pinned per account on first connect. Set this for strict checking.
# PULSE_SSH_KNOWN_HOSTS=/home/pulse/.ssh/known_hosts
# PULSE_SSH_CONNECT_TIMEOUT_SECONDS=10
# PULSE_SSH_COMMAND_TIMEOUT_SECONDS=30
# PULSE_SSH_KEEPALIVE_SECONDS=60

# Optional cluster assistant. Requires direct SSH and the chosen CLI in the cluster's
# login PATH. Users complete native sign-in from the UI; Pulse never reads tokens.
# PULSE_ASSISTANTS_ENABLED=false
# Disconnect idle assistant connections after 15 minutes (active work keeps running).
# PULSE_ASSISTANT_IDLE_SECONDS=900

# Poll every 10 s while the app is open somewhere, every 60 s otherwise.
PULSE_POLL_INTERVAL_LIVE_SECONDS=10
PULSE_POLL_INTERVAL_IDLE_SECONDS=60
# Per-node CPU/memory/GPU sampling starts a Slurm job step; keep it infrequent.
PULSE_NODE_STATS_INTERVAL_SECONDS=60
PULSE_METRIC_DISCOVERY_INTERVAL_SECONDS=60
# Defaults for each user's alert settings (users can change theirs in the app).
PULSE_STALL_MINUTES=15
PULSE_TIME_LIMIT_WARNING_RATIO=0.9
PULSE_DIVERGE_PERCENT=50
PULSE_PLATEAU_MINUTES=60

# Web Push. Unset: Pulse generates a key pair in data/vapid.json on first start.
# Set both to manage them yourself (pulse gen-vapid prints a pair).
# PULSE_VAPID_PUBLIC_KEY=
# PULSE_VAPID_PRIVATE_KEY=
# PULSE_VAPID_SUBJECT=mailto:you@example.com   # contact for push services; default: PULSE_PUBLIC_URL
# PULSE_PUSH_TTL_SECONDS=21600
# Push goes only to the major browsers' push services; add hosts for others here.
# PULSE_PUSH_EXTRA_HOSTS=["push.example.org"]
