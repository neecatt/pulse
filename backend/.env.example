# Copy to .env and adjust. Every setting is optional; defaults are in src/pulse/config.py.

PULSE_DATABASE_URL=sqlite+aiosqlite:///./pulse.db
PULSE_CORS_ORIGINS=["http://localhost:5173"]

# "mock" simulates a cluster; "ssh" runs sacct on each account's login node.
PULSE_SLURM_BACKEND=mock
# PULSE_SSH_KEY_PATH=/home/pulse/.ssh/id_ed25519   # default: ssh-agent / ~/.ssh
# PULSE_SSH_KNOWN_HOSTS=/home/pulse/.ssh/known_hosts

PULSE_POLL_INTERVAL_SECONDS=30
PULSE_STALL_MINUTES=15
PULSE_TIME_LIMIT_WARNING_RATIO=0.9

# Web Push. Generate a pair with: pulse gen-vapid
# PULSE_VAPID_PUBLIC_KEY=
# PULSE_VAPID_PRIVATE_KEY=
PULSE_VAPID_SUBJECT=mailto:you@example.com
