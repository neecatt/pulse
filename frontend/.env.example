# Copy to .env.local and adjust. Everything here is optional.
# Values prefixed with VITE_ are embedded in the public bundle: never put secrets here.

# API origin when the web app is served separately from the API
# (e.g. https://pulse.example.org). Leave unset when one process serves both.
# VITE_API_URL=

# Dev server only: where `bun run dev` proxies /api requests.
# PULSE_API_PROXY=http://localhost:8000
