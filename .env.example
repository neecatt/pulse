# Settings for `docker compose` (compose.yaml). Copy to .env and fill in.
# Every PULSE_* setting is documented in backend/.env.example.

# Public name of this server; Caddy gets an HTTPS certificate for it.
PULSE_DOMAIN=pulse.example.org

# Admin account. The password follows this file: change it here and restart.
# Leave both unset to create the admin in the browser with the setup code
# printed in `docker compose logs pulse`.
PULSE_ADMIN_USERNAME=admin
PULSE_ADMIN_PASSWORD=

# "ssh" (default in the image) polls real clusters; "mock" runs a demo cluster.
# PULSE_SLURM_BACKEND=ssh

# Push notifications work without any setup: Pulse creates its keys in /data.
# Contact for push services (defaults to https://PULSE_DOMAIN):
# PULSE_VAPID_SUBJECT=mailto:you@example.org

# Let anyone with the URL create their own account (each sees only their own data).
# PULSE_ALLOW_SIGNUP=false
# A public site: landing page plus a "Try the demo" button (simulated clusters,
# temporary guest accounts deleted after a day). Real accounts stay real.
# PULSE_DEMO=false
